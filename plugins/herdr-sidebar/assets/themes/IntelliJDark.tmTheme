<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IntelliJ Dark syntax theme for herdr-sidebar's file preview.
  An original color mapping inspired by the JetBrains IntelliJ New UI "Dark" scheme;
  written for this project and distributed under the crate's MIT license.
  The preview paints only foregrounds unless "background": true is set in
  syntax-theme.json, which also uses background and gutterForeground.
-->
